comptime Color = Enum {
    Red,
    Green,
    Blue,
};

func main(): Void {
    let total: Int32 = 0;
    match total {
        case 0 { total += 1; }
        case 2 or 3 or 4 { total += 10; }
        else { total = 0; }
    }
    let c: Color = Color.Green;
    match c {
        case Color.Red { pass; }
        case Color.Green { pass; }
        case Color.Blue { pass; }
    }
    let label: Int32 = match total {
        case 0 { 100 }
        case 1 or 2 { 200 }
        else { 300 }
    };
    pass;
}
