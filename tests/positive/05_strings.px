/*
 * String and character literals with escape sequences.
 * Array sizes are the decoded length plus the implicit null terminator.
 */
func main(): Void {
    let s: Char[9] = "tab\there";
    let q: Char[4] = "a\"b";
    let b: Char[2] = "\\";
    let c: Char = 'a';
    let n: Char = '\n';
    let x: Char = '\x41';
    let z: Char = '\0';
    let i = "val {1 + 2}\nend";
    pass;
}
