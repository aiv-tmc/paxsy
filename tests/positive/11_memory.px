/*
 * Pointers, address-of, dereference, alloc/free, zero-pointer check.
 */
func main(): Void {
    let a: Int32 = 5;
    let p: &Int32 = &a;
    @p = 10;
    let b: Int32 = @p;
    let buf: &Int32 = alloc Int32[4];
    if buf == 0 {
        pass;
    }
    @buf = 42;
    let v: Int32 = @buf;
    free buf;
    pass;
}
