func cast_to(comptime T, value: Int32): T {
    return value as T;
}

func identity(comptime T, x: T): T {
    return x;
}

func main(): Void {
    let a: Real64 = cast_to(Real64, 42);
    let b: Int16 = cast_to(Int16, 42);
    let c: Int32 = identity(Int32, 7);
    let d: Real64 = identity(Real64, 2.5);
    pass;
}
