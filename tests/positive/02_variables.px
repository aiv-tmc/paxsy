/*
 * Variable declarations, arithmetic, promotion, and branches.
 */
func main(): Void {
    let a: Int32 = 5;
    let b = 300;
    let c: Real64 = 2.5;
    let d: Bool = true;
    a += 1;
    if a > b {
        a = b;
    } else {
        b = a;
    }
    while a > 0 {
        a -= 1;
    }
    if d {
        c = c * 2.0;
    }
    pass;
}
