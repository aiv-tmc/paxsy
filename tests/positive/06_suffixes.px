/*
 * Numeric literal suffixes.
 * U selects the smallest unsigned integer type holding the value;
 * f selects Real32 when the value fits and Real64 otherwise.
 */
func main(): Void {
    let u: UInt8 = 255U;
    let u2: UInt16 = 256U;
    let r: Real32 = 3.14f;
    let r2: Real64 = 1e40f;
    let h: Real32 = 0x1.8p1f;
    pass;
}
