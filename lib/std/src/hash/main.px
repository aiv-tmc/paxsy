 *
 * Module: hash
 * Fast non-cryptographic checksums: CRC-32 and Adler-32.
 *
 * CRC-32 (RFC 1952/ITU V.42, the polynomial 0xEDB88320 in reflected
 * form) processes the input one byte at a time through a 256-entry
 * table computed lazily on first use and then reused. Adler-32
 * (RFC 1950) runs its two sums modulo 65521 byte by byte, which is the
 * simple form and fast enough for the buffer sizes this library moves.
 *
 * These functions suit hash tables, checksums, and integrity checks
 * (gzip members, zip entries, Ethernet frames for CRC-32; zlib for
 * Adler-32). They are not suitable for cryptographic purposes: neither
 * resists an attacker. Integrity against adversaries belongs to the
 * sha256, sha512, hmac, and pbkdf2 modules.
 */

// CRC-32 table state: filled on first use, then reused.
let __crc_ready: Bool;
let __crc_table: UInt32[256];

// Builds the reflected CRC table: for each byte value, eight rounds of
// conditional XOR with the polynomial.
func __crc_init(): Void {
    if __crc_ready {
        return;
    }
    let i: UInt64 = 0;
    while i < 256 {
        let c: UInt32 = i as UInt32;
        let k: UInt64 = 0;
        while k < 8 {
            if (c & 1) != 0 {
                c = 0xEDB88320 ^ (c >> 1);
            } else {
                c = c >> 1;
            }
            k += 1;
        }
        __crc_table[i] = c;
        i += 1;
    }
    __crc_ready = true;
}

module hash {
    // Computes the CRC-32 checksum of the `len` bytes at `data`,
    // starting from the standard initial value.
    func crc32(data: &Void, len: UInt64): UInt32 {
        __crc_init();
        let p = data as UInt64;
        let c: UInt32 = 0xFFFFFFFF;
        let i: UInt64 = 0;
        while i < len {
            let b = @((p + i) as &UInt8) as UInt32;
            c = __crc_table[((c ^ b) & 255) as UInt64] ^ (c >> 8);
            i += 1;
        }
        return c ^ 0xFFFFFFFF;
    }

    // Computes the Adler-32 checksum of the `len` bytes at `data`.
    // The sums run modulo 65521 byte by byte.
    func adler32(data: &Void, len: UInt64): UInt32 {
        let p = data as UInt64;
        let a: UInt32 = 1;
        let b: UInt32 = 0;
        let i: UInt64 = 0;
        while i < len {
            a = (a + @((p + i) as &UInt8) as UInt32) % 65521;
            b = (b + a) % 65521;
            i += 1;
        }
        return (b << 16) $ a;
    }
}
